rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Safety Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'ritesh.ds.001@gmail.com');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper functions for content validations
    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.email is string && data.email.size() <= 150
          && data.name is string && data.name.size() <= 150
          && data.role is string && (data.role == 'customer' || data.role == 'admin')
          && data.referralCode is string && data.referralCode.size() <= 50;
    }

    function isValidProduct(data) {
      return data.productId is string && data.productId.size() <= 128
          && data.title is string && data.title.size() <= 150
          && data.description is string && data.description.size() <= 2000
          && data.category is string && (data.category == 'jerseys' || data.category == 'oversized' || data.category == 'vests')
          && data.price is number && data.price >= 0
          && data.stock is number && data.stock >= 0;
    }

    function isValidOrder(data) {
      return data.orderId is string && data.orderId.size() <= 128
          && data.userId is string && data.userId.size() <= 128
          && data.customerEmail is string && data.customerEmail.size() <= 150
          && data.subtotal is number && data.subtotal >= 0
          && data.shipping is number && data.shipping >= 0
          && data.discount is number && data.discount >= 0
          && data.total is number && data.total >= 0
          && data.status is string && (
               data.status == 'Pending' || data.status == 'Confirmed' ||
               data.status == 'Processing' || data.status == 'Shipped' ||
               data.status == 'Out For Delivery' || data.status == 'Delivered'
             );
    }

    function isValidReview(data) {
      return data.reviewId is string && data.reviewId.size() <= 128
          && data.productId is string && data.productId.size() <= 128
          && data.userId is string && data.userId.size() <= 128
          && data.userName is string && data.userName.size() <= 150
          && data.comment is string && data.comment.size() <= 1000
          && data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    function isValidCustomDesign(data) {
      return data.designId is string && data.designId.size() <= 128
          && data.userId is string && data.userId.size() <= 128
          && data.email is string && data.email.size() <= 150
          && data.productType is string && (data.productType == 'Football Jersey' || data.productType == 'Oversized Tee' || data.productType == 'Gym Vest')
          && data.notes is string && data.notes.size() <= 1000
          && data.imageUrl is string && data.imageUrl.size() <= 1000;
    }

    // 3. Document Match Handlers
    
    // Users Profile Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (incoming().role == 'customer' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        isAdmin() || (isOwner(userId) && incoming().role == existing().role && incoming().referralCode == existing().referralCode)
      );
      allow delete: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Public listings
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid && existing().status != 'Delivered' && 
         incoming().diff(existing()).affectedKeys().hasOnly(['shippingAddress', 'customerEmail']))
      );
      allow delete: if isAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Public reviews
      allow create: if isSignedIn() && isValidReview(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidReview(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Wishlist Collection
    match /wishlist/{wishlistId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true; // Public coupon verification
      allow create, update, delete: if isAdmin();
    }

    // Referrals Collection
    match /referrals/{referralId} {
      allow read: if isSignedIn() && (resource.data.referrerId == request.auth.uid || resource.data.referredUserId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().referredUserId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Custom Designs Collection
    match /custom_designs/{designId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidCustomDesign(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'admin' || isAdmin());
      allow create: if isSignedIn() && (incoming().userId == 'admin' || isAdmin() || incoming().userId == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
